<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Desde Android 11 una app sólo ve los paquetes que declara. Slowtown
         necesita verlos todos: lista lo que se puede abrir, lee qué paquete
         dibuja la pantalla de llamada y de emergencia, y durante una sesión de
         administración habilita todo lo instalado. No va a Play, así que la
         política de Play sobre este permiso no aplica. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- El tiempo de pantalla de Inicio, lo mismo que muestra Bienestar
         digital. Lo da provisionar.sh por adb (appops GET_USAGE_STATS): con
         Slowtown activo, la pantalla de Ajustes para darlo no se alcanza. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- La hora de dormir empieza y termina a horario: provisionar.sh da el
         permiso por adb (appops SCHEDULE_EXACT_ALARM); sin él, la alarma es
         aproximada. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- «Desinstalar» en la lista de todas las apps. Sin Device Owner abre el
         diálogo de Android, que sin este permiso no se muestra; con Device
         Owner, Slowtown desinstala sin el diálogo (ya preguntó él). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- Para esconder la hora de la barra en Inicio (StatusBarClock): Android
         no lo deja hacer de otra manera. No se da al instalar: lo da
         provisionar.sh por adb, y sin él la barra queda como está. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".SlowtownApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Slowtown">

        <!-- La pantalla de inicio. LAUNCHER además de HOME para poder abrirla
             desde el launcher de fábrica antes de elegirla como inicio. -->
        <activity
            android:name=".HomeActivity"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El final agendado de una sesión de administración. Sólo lo dispara
             la alarma de Slowtown: no se exporta. -->
        <receiver
            android:name=".admin.AdminSession$End"
            android:exported="false" />

        <!-- El final agendado de «Habilitar todo». Tampoco se exporta. -->
        <receiver
            android:name=".admin.FreeSession$End"
            android:exported="false" />

        <!-- La hora de dormir: empieza, termina o se acaba una ráfaga. Sólo lo
             disparan las alarmas de Slowtown: no se exporta. -->
        <receiver
            android:name=".admin.Bedtime$Tick"
            android:exported="false" />

        <!-- Las notificaciones por oleadas: lee las notificaciones de las apps
             elegidas y las pospone hasta la próxima entrega. El permiso lo da
             provisionar.sh por adb (cmd notification allow_listener). -->
        <service
            android:name=".notif.WavesListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- La salida por cable (scripts/liberar.sh). Exportado sin permiso a
             propósito: `adb shell content call` corre como shell, y el propio
             proveedor rechaza a cualquiera que no sea shell o root. -->
        <provider
            android:name=".admin.CableProvider"
            android:authorities="com.slowtown.launcher.cable"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />

        <!-- Lo que `dpm set-device-owner` activa. -->
        <receiver
            android:name=".admin.SlowtownAdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
